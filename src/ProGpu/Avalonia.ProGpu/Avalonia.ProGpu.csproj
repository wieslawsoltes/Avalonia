<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AvsCurrentTargetFramework)</TargetFrameworks>
    <IncludeLinuxSkia>false</IncludeLinuxSkia>
    <IncludeWasmSkia>false</IncludeWasmSkia>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>ProGPU.Avalonia.Rendering</PackageId>
    <Title>ProGPU rendering platform for Avalonia</Title>
    <Description>GPU-accelerated Avalonia rendering platform backed by ProGPU, Silk.NET, and WebGPU.</Description>
    <PackageTags>progpu;avalonia;rendering;webgpu;silk.net;gpu</PackageTags>
  </PropertyGroup>
  <Import Project="..\..\..\build\ProGpuIntegration.props" />
  <ItemGroup>
    <EmbeddedResource Include="Assets\NoiseAsset_256X256_PNG.png" />
    <Compile Include="$(ProGpuSourceRoot)\src\ProGPU.Avalonia.Rendering\ProGpuTextShaper.cs"
             Link="Text\ProGpuTextShaper.cs" />
    <Compile Include="$(ProGpuSourceRoot)\src\ProGPU.Avalonia.Rendering\ProGpuTextShapingApplicationExtensions.cs"
             Link="Text\ProGpuTextShapingApplicationExtensions.cs" />
    <Compile Include="$(ProGpuSourceRoot)\src\ProGPU.Avalonia.Rendering\ProGpuRenderingDiagnostics.cs"
             Link="Diagnostics\ProGpuRenderingDiagnostics.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(ProGpuDependencyMode)' == 'Source'">
    <ProjectReference Include="$(ProGpuAvaloniaSourceProject)" />
    <ProjectReference Include="$(ProGpuSourceRoot)\src\ProGPU.Backend\ProGPU.Backend.csproj" />
    <ProjectReference Include="$(ProGpuSourceRoot)\src\ProGPU.Vector\ProGPU.Vector.csproj" />
    <ProjectReference Include="$(ProGpuSourceRoot)\src\ProGPU.Text\ProGPU.Text.csproj" />
    <ProjectReference Include="$(ProGpuSourceRoot)\src\ProGPU.Compute\ProGPU.Compute.csproj" />
    <ProjectReference Include="$(ProGpuSourceRoot)\src\ProGPU.Scene\ProGPU.Scene.csproj" />
    <PackageReference Include="OpenFontSharp" />
    <PackageReference Include="StbImageSharp" />
  </ItemGroup>
  <ItemGroup Condition="'$(ProGpuDependencyMode)' == 'Package'">
    <PackageReference Include="Avalonia" VersionOverride="[$(ProGpuAvaloniaVersion)]" />
    <PackageReference Include="ProGPU.Backend" VersionOverride="[$(ProGpuRuntimeVersion)]" />
    <PackageReference Include="ProGPU.Vector" VersionOverride="[$(ProGpuRuntimeVersion)]" />
    <PackageReference Include="ProGPU.Text" VersionOverride="[$(ProGpuRuntimeVersion)]" />
    <PackageReference Include="ProGPU.Compute" VersionOverride="[$(ProGpuRuntimeVersion)]" />
    <PackageReference Include="ProGPU.Scene" VersionOverride="[$(ProGpuRuntimeVersion)]" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>


  <Import Project="..\..\..\build\DevAnalyzers.props" />
  <Import Project="..\..\..\build\TrimmingEnable.props" />
  <Import Project="..\..\..\build\NullableEnable.props" />

  <ItemGroup Label="InternalsVisibleTo">
    <InternalsVisibleTo Include="Avalonia.ProGpu.RenderTests, PublicKey=$(AvaloniaPublicKey)" />
    <InternalsVisibleTo Include="Avalonia.ProGpu.UnitTests, PublicKey=$(AvaloniaPublicKey)" />
    <InternalsVisibleTo Include="Avalonia.Benchmarks, PublicKey=$(AvaloniaPublicKey)" />
  </ItemGroup>
</Project>
