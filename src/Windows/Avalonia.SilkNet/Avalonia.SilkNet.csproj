<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AvsCurrentTargetFramework)</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <PackageId>ProGPU.Avalonia.SilkNet</PackageId>
    <Title>Silk.NET windowing platform for Avalonia and ProGPU</Title>
    <Description>Cross-platform Silk.NET windowing platform for Avalonia applications using ProGPU or another Avalonia renderer.</Description>
    <PackageTags>progpu;avalonia;windowing;silk.net;webgpu;desktop</PackageTags>
  </PropertyGroup>
  <Import Project="..\..\..\build\ProGpuIntegration.props" />
  <ItemGroup Condition="'$(ProGpuDependencyMode)' == 'Source'">
    <ProjectReference Include="$(ProGpuAvaloniaSourceProject)" />
    <ProjectReference Include="$(ProGpuSourceRoot)\src\ProGPU.Backend\ProGPU.Backend.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ProGpuDependencyMode)' == 'Package'">
    <PackageReference Include="Avalonia" VersionOverride="[$(ProGpuAvaloniaVersion)]" />
    <PackageReference Include="ProGPU.Backend" VersionOverride="[$(ProGpuRuntimeVersion)]" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="Silk.NET.Input" />
    <PackageReference Include="Silk.NET.WebGPU" />
    <PackageReference Include="Silk.NET.WebGPU.Native.WGPU" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>
  <Import Project="..\..\..\build\NullableEnable.props" />
  <Import Project="..\..\..\build\DevAnalyzers.props" />
  <Import Project="..\..\..\build\TrimmingEnable.props" />
  <PropertyGroup Label="Warnings">
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup Label="InternalsVisibleTo">
    <InternalsVisibleTo Include="Avalonia.IntegrationTests.SilkNet, PublicKey=$(AvaloniaPublicKey)" />
  </ItemGroup>
</Project>
