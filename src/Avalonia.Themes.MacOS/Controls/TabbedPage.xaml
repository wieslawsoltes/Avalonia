<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Width="400" Height="400">
      <TabbedPage>
        <ContentPage Header="Home">
          <TextBlock Text="Home page" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ContentPage>
        <ContentPage Header="Favorites">
          <TextBlock Text="Favorites page" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ContentPage>
        <ContentPage Header="Profile">
          <TextBlock Text="Profile page" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ContentPage>
      </TabbedPage>
    </Border>
  </Design.PreviewWith>

  <!-- Backgrounds -->
  <SolidColorBrush x:Key="MacOS.TabbedPageTabItemHeaderBackgroundUnselected" Color="Transparent" />
  <SolidColorBrush x:Key="MacOS.TabbedPageTabItemHeaderBackgroundSelected" Color="Transparent" />
  <SolidColorBrush x:Key="MacOS.TabbedPageTabItemHeaderBackgroundUnselectedPointerOver" Color="{DynamicResource MacOS.SystemListLowColor}" />
  <SolidColorBrush x:Key="MacOS.TabbedPageTabItemHeaderBackgroundSelectedPointerOver" Color="Transparent" />
  <SolidColorBrush x:Key="MacOS.TabbedPageTabItemHeaderBackgroundUnselectedPressed" Color="{DynamicResource MacOS.SystemListMediumColor}" />
  <SolidColorBrush x:Key="MacOS.TabbedPageTabItemHeaderBackgroundSelectedPressed" Color="Transparent" />
  <SolidColorBrush x:Key="MacOS.TabbedPageTabItemHeaderBackgroundDisabled" Color="Transparent" />

  <!-- Foregrounds (override via TabbedPageTabItemHeaderForegroundSelected / TabbedPageTabItemHeaderForegroundUnselected resources) -->
  <SolidColorBrush x:Key="MacOS.TabbedPageTabItemHeaderForegroundUnselected" Color="{DynamicResource MacOS.SystemBaseMediumColor}" />
  <SolidColorBrush x:Key="MacOS.TabbedPageTabItemHeaderForegroundSelected" Color="{DynamicResource MacOS.SystemAccentColor}" />
  <SolidColorBrush x:Key="MacOS.TabbedPageTabItemHeaderForegroundDisabled" Color="{DynamicResource MacOS.SystemBaseLowColor}" />
  <x:Double x:Key="MacOS.TabbedPageTabItemHeaderPipeThickness">2</x:Double>
  <x:Double x:Key="MacOS.TabbedPageTabItemHeaderVerticalPipeHeight">18</x:Double>

  <CornerRadius x:Key="MacOS.TabbedPageTabItemHeaderIndicatorCornerRadius">0</CornerRadius>
  <Thickness x:Key="MacOS.TabbedPageTabItemHeaderIndicatorMargin">0</Thickness>

  <!-- Tab item sizing & shape -->
  <x:Double x:Key="MacOS.TabbedPageTabItemHeaderMinHeight">48</x:Double>
  <CornerRadius x:Key="MacOS.TabbedPageTabItemHeaderCornerRadius">0</CornerRadius>
  <Thickness x:Key="MacOS.TabbedPageTabItemHeaderPadding">8,4</Thickness>
  <Thickness x:Key="MacOS.TabbedPageTabItemHeaderMargin">0</Thickness>

  <!-- Icon + text header layout -->
  <x:Double x:Key="MacOS.TabbedPageTabItemHeaderIconSize">20</x:Double>
  <x:Double x:Key="MacOS.TabbedPageTabItemHeaderFontSize">12</x:Double>
  <x:Double x:Key="MacOS.TabbedPageTabItemHeaderSpacing">4</x:Double>

  <!-- Tab strip (bar) styling -->
  <SolidColorBrush x:Key="MacOS.TabbedPageTabStripBackground" Color="Transparent" />
  <CornerRadius x:Key="MacOS.TabbedPageTabStripCornerRadius">0</CornerRadius>
  <Thickness x:Key="MacOS.TabbedPageTabStripBorderThickness">0</Thickness>
  <SolidColorBrush x:Key="MacOS.TabbedPageTabStripBorderBrush" Color="Transparent" />
  <Thickness x:Key="MacOS.TabbedPageTabStripMargin">0</Thickness>
  <Thickness x:Key="MacOS.TabbedPageTabStripPadding">0</Thickness>

  <!-- TabbedPage TabControl theme -->
  <ControlTheme x:Key="TabbedPageTabControlTheme" TargetType="TabControl">
    <Setter Property="Background" Value="{DynamicResource MacOS.TabbedPageTabStripBackground}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MacOS.TabbedPageTabStripCornerRadius}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MacOS.TabbedPageTabStripBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource MacOS.TabbedPageTabStripBorderThickness}" />
    <Setter Property="Padding" Value="{DynamicResource MacOS.TabbedPageTabStripPadding}" />
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border Name="PART_TabStrip"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Margin="{DynamicResource MacOS.TabbedPageTabStripMargin}"
                  Padding="{TemplateBinding Padding}"
                  DockPanel.Dock="{TemplateBinding TabStripPlacement}">
            <ItemsPresenter Name="PART_ItemsPresenter">
              <ItemsPresenter.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsPresenter.ItemsPanel>
            </ItemsPresenter>
          </Border>
          <Panel ClipToBounds="True">
            <ContentPresenter Name="PART_SelectedContentHost2"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              IsVisible="False" />
            <ContentPresenter Name="PART_SelectedContentHost"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch" />
          </Panel>
        </DockPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter > UniformGrid,
           ^[TabStripPlacement=Right] /template/ ItemsPresenter#PART_ItemsPresenter > UniformGrid">
      <Setter Property="Rows" Value="0" />
      <Setter Property="Columns" Value="1" />
    </Style>
  </ControlTheme>

  <!-- TabbedPage TabItem theme -->
  <ControlTheme x:Key="TabbedPageTabItemTheme" TargetType="TabItem">
    <Setter Property="FontSize" Value="{DynamicResource MacOS.TabItemHeaderFontSize}" />
    <Setter Property="FontWeight" Value="{DynamicResource MacOS.TabItemHeaderThemeFontWeight}" />
    <Setter Property="Background" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderBackgroundUnselected}" />
    <Setter Property="Foreground" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderForegroundUnselected}" />
    <Setter Property="Padding" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderPadding}" />
    <Setter Property="Margin" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderMargin}" />
    <Setter Property="MinHeight" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderMinHeight}" />
    <Setter Property="CornerRadius" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderCornerRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="IndicatorTemplate">
      <DataTemplate>
        <Border Background="{Binding $parent[TabItem].Foreground}"
                CornerRadius="{DynamicResource MacOS.TabbedPageTabItemHeaderIndicatorCornerRadius}"
                Margin="{DynamicResource MacOS.TabbedPageTabItemHeaderIndicatorMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
      </DataTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_LayoutRoot"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <StackPanel Name="PART_HeaderPanel"
                        Spacing="{DynamicResource MacOS.TabbedPageTabItemHeaderSpacing}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <ContentPresenter Name="PART_IconPresenter"
                                Content="{TemplateBinding Icon}"
                                ContentTemplate="{TemplateBinding IconTemplate}"
                                HorizontalAlignment="Center"
                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Width="{DynamicResource MacOS.TabbedPageTabItemHeaderIconSize}"
                                Height="{DynamicResource MacOS.TabbedPageTabItemHeaderIconSize}" />
              <ContentPresenter Name="PART_ContentPresenter"
                                HorizontalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{DynamicResource MacOS.TabbedPageTabItemHeaderFontSize}"
                                FontWeight="{TemplateBinding FontWeight}" />
            </StackPanel>
          </Border>
          <ContentPresenter Name="PART_SelectedPipe"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Content="{TemplateBinding DataContext}"
                            ContentTemplate="{TemplateBinding IndicatorTemplate}"
                            IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Selected state -->
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderBackgroundSelected}" />
      <Setter Property="Foreground" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderForegroundSelected}" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_SelectedPipe">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Placement-specific pipe positioning -->
    <Style Selector="^[TabStripPlacement=Top] /template/ ContentPresenter#PART_SelectedPipe">
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Height" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderPipeThickness}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Bottom] /template/ ContentPresenter#PART_SelectedPipe">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Height" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderPipeThickness}" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right]">
      <Setter Property="IndicatorTemplate">
        <DataTemplate>
          <Border Background="{Binding $parent[TabItem].Foreground}"
                  CornerRadius="{DynamicResource MacOS.TabbedPageTabItemHeaderIndicatorCornerRadius}"
                  Margin="{DynamicResource MacOS.TabbedPageTabItemHeaderIndicatorMargin}"
                  Width="{DynamicResource MacOS.TabbedPageTabItemHeaderPipeThickness}"
                  Height="{DynamicResource MacOS.TabbedPageTabItemHeaderVerticalPipeHeight}" />
        </DataTemplate>
      </Setter>
    </Style>
    <Style Selector="^[TabStripPlacement=Right] /template/ ContentPresenter#PART_SelectedPipe">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="^[TabStripPlacement=Left]">
      <Setter Property="IndicatorTemplate">
        <DataTemplate>
          <Border Background="{Binding $parent[TabItem].Foreground}"
                  CornerRadius="{DynamicResource MacOS.TabbedPageTabItemHeaderIndicatorCornerRadius}"
                  Margin="{DynamicResource MacOS.TabbedPageTabItemHeaderIndicatorMargin}"
                  Width="{DynamicResource MacOS.TabbedPageTabItemHeaderPipeThickness}"
                  Height="{DynamicResource MacOS.TabbedPageTabItemHeaderVerticalPipeHeight}" />
        </DataTemplate>
      </Setter>
    </Style>
    <Style Selector="^[TabStripPlacement=Left] /template/ ContentPresenter#PART_SelectedPipe">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Pointer-over -->
    <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderBackgroundUnselectedPointerOver}" />
    </Style>

    <!-- Selected + pointer-over -->
    <Style Selector="^:selected:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderBackgroundSelectedPointerOver}" />
    </Style>

    <!-- Pressed -->
    <Style Selector="^:pressed /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderBackgroundUnselectedPressed}" />
    </Style>

    <!-- Selected + pressed -->
    <Style Selector="^:selected:pressed /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderBackgroundSelectedPressed}" />
    </Style>

    <!-- Disabled -->
    <Style Selector="^:disabled /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderBackgroundDisabled}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource MacOS.TabbedPageTabItemHeaderForegroundDisabled}" />
    </Style>

    <!-- Focus visible -->
    <Style Selector="^:focus-visible /template/ Border#PART_LayoutRoot">
      <Setter Property="BorderBrush" Value="{DynamicResource MacOS.SystemControlForegroundBaseHighBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TabbedPage}" TargetType="TabbedPage">
    <Setter Property="Background" Value="{DynamicResource MacOS.SystemControlPageBackgroundAltHighBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <TabControl Name="PART_TabControl"
                      Theme="{StaticResource TabbedPageTabControlTheme}"
                      ItemContainerTheme="{StaticResource TabbedPageTabItemTheme}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
