<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:generic="using:System.Collections.Generic"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <AutoCompleteBox Width="200">
        <AutoCompleteBox.ItemsSource>
          <generic:List x:TypeArguments="x:String">
            Alabama
            Alaska
            Arizona
            Arkansas
            California
            Colorado
            Connecticut
            Delaware
          </generic:List>
        </AutoCompleteBox.ItemsSource>
      </AutoCompleteBox>
    </Border>
  </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type AutoCompleteBox}" TargetType="AutoCompleteBox">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Foreground" Value="{DynamicResource MacOS.TextControlForeground}" />
      <Setter Property="Background" Value="{DynamicResource MacOS.TextControlBackground}" />
      <Setter Property="PlaceholderForeground" Value="{DynamicResource MacOS.TextControlPlaceholderForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource MacOS.TextControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="{DynamicResource MacOS.TextControlBorderThemeThickness}" />
      <Setter Property="CornerRadius" Value="{DynamicResource MacOS.ControlCornerRadius}" />
      <Setter Property="Padding" Value="{DynamicResource MacOS.TextControlThemePadding}" />
      <Setter Property="MaxDropDownHeight" Value="{DynamicResource MacOS.AutoCompleteListMaxHeight}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="PART_LayoutRoot">
            <TextBox Name="PART_TextBox"
                     PlaceholderText="{TemplateBinding PlaceholderText}"
                     PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                     Width="{TemplateBinding Width}"
                     Foreground="{TemplateBinding Foreground}"
                     Background="{TemplateBinding Background}"
                     BorderBrush="{TemplateBinding BorderBrush}"
                     BorderThickness="{TemplateBinding BorderThickness}"
                     CornerRadius="{TemplateBinding CornerRadius}"
                     CaretIndex="{TemplateBinding CaretIndex, Mode=TwoWay}"
                     ClearSelectionOnLostFocus="{TemplateBinding ClearSelectionOnLostFocus}"
                     Padding="{TemplateBinding Padding}"
                     Margin="0"
                     DataValidationErrors.Errors="{TemplateBinding (DataValidationErrors.Errors)}"
                     MaxLength="{TemplateBinding MaxLength}"
                     InnerLeftContent="{TemplateBinding InnerLeftContent}"
                     InnerRightContent="{TemplateBinding InnerRightContent}"
                     />
            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   IsLightDismissEnabled="True"
                   PlacementTarget="{TemplateBinding}">
              <Border Name="PART_SuggestionsContainer"
                      Padding="{DynamicResource MacOS.AutoCompleteListMargin}"
                      BorderThickness="{DynamicResource MacOS.AutoCompleteListBorderThemeThickness}"
                      BorderBrush="{DynamicResource MacOS.AutoCompleteBoxSuggestionsListBorderBrush}"
                      Background="{DynamicResource MacOS.AutoCompleteBoxSuggestionsListBackground}"
                      CornerRadius="{DynamicResource MacOS.OverlayCornerRadius}">
                <ListBox Name="PART_SelectingItemsControl"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemTemplate="{TemplateBinding ItemTemplate}"
                         Margin="{DynamicResource MacOS.AutoCompleteListPadding}"
                         ScrollViewer.IsScrollChainingEnabled="False" />
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

</ResourceDictionary>
