<Project>
  <PropertyGroup>
    <ProGpuDependencyMode Condition="'$(ProGpuDependencyMode)' == ''">Source</ProGpuDependencyMode>
    <ProGpuAvaloniaVersion Condition="'$(ProGpuAvaloniaVersion)' == ''">12.0.5</ProGpuAvaloniaVersion>
    <ProGpuRuntimeVersion Condition="'$(ProGpuRuntimeVersion)' == ''">0.1.0-preview.10</ProGpuRuntimeVersion>
    <ProGpuIntegrationVersion Condition="'$(ProGpuIntegrationVersion)' == ''">12.0.5-preview.9</ProGpuIntegrationVersion>
    <ProGpuSourceRoot Condition="'$(ProGpuSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../ProGPU</ProGpuSourceRoot>
    <ProGpuAvaloniaSourceProject Condition="'$(ProGpuAvaloniaSourceProject)' == ''">$(MSBuildThisFileDirectory)../packages/Avalonia/Avalonia.csproj</ProGpuAvaloniaSourceProject>

    <AvaloniaAccessUnstablePrivateApis Condition="'$(ProGpuDependencyMode)' == 'Package'">true</AvaloniaAccessUnstablePrivateApis>
    <Avalonia_I_Want_To_Use_Private_Apis_In_Nuget_Package_And_Promise_To_Pin_The_Exact_Avalonia_Version_In_Package_Dependency
      Condition="'$(ProGpuDependencyMode)' == 'Package'">true</Avalonia_I_Want_To_Use_Private_Apis_In_Nuget_Package_And_Promise_To_Pin_The_Exact_Avalonia_Version_In_Package_Dependency>

    <VersionPrefix>12.0.5</VersionPrefix>
    <VersionSuffix>preview.9</VersionSuffix>
    <Version>$(ProGpuIntegrationVersion)</Version>
    <PackageVersion>$(ProGpuIntegrationVersion)</PackageVersion>
    <Product>ProGPU Avalonia Integration</Product>
    <Authors>Wieslaw Soltes</Authors>
    <Company>ProGPU</Company>
    <PackageDescription>$(Description)</PackageDescription>
    <Copyright>Copyright (c) Avalonia contributors and Wieslaw Soltes</Copyright>
    <PackageProjectUrl>https://github.com/wieslawsoltes/Avalonia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wieslawsoltes/Avalonia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>ProGpuAvaloniaIcon.png</PackageIcon>
    <PackageReleaseNotes>Uses ProGPU 0.1.0-preview.10 with retained glyph-run rendering, stable glyph-atlas overflow fallback, bounded uniform-ring batching, corrected text opacity and image alpha semantics, and expanded SkiaSharp/Svg.Skia compatibility while retaining full-frame ProGPU presentation.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)Assets/Icon.png" />
    <None Include="$(MSBuildThisFileDirectory)Assets/ProGpuAvaloniaIcon.png"
          Pack="true"
          PackagePath=""
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)Assets/ProGpuAvaloniaIcon.svg"
          Pack="true"
          PackagePath=""
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../docs/progpu-package-readme.md"
          Pack="true"
          PackagePath="README.md"
          Visible="false" />
  </ItemGroup>

  <Target Name="ValidateProGpuDependencyMode" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ProGpuDependencyMode)' != 'Source' And '$(ProGpuDependencyMode)' != 'Package'"
           Text="ProGpuDependencyMode must be either 'Source' or 'Package'." />
    <Error Condition="'$(ProGpuDependencyMode)' == 'Source' And !Exists('$(ProGpuSourceRoot)/src/ProGPU.Backend/ProGPU.Backend.csproj')"
           Text="ProGPU source projects were not found under '$(ProGpuSourceRoot)'. Set ProGpuSourceRoot or use -p:ProGpuDependencyMode=Package." />
  </Target>
</Project>
