<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>latest</LangVersion>
    <Version>0.1.0</Version><Authors>CounterPOS contributors</Authors><PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally><AvaloniaVersion>12.1.4</AvaloniaVersion>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault><Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
